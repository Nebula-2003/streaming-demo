# LiveKit Configuration
# WebSocket port (see docker-compose; default 17880 avoids conflict with another LiveKit on 7880)
LIVEKIT_WS_PORT=17880
# Local dev: ws://. Production (public viewers): put a TLS reverse proxy (Caddy/Nginx) in
# front of LiveKit and switch to wss://your-domain so browsers on HTTPS pages can connect.
LIVEKIT_URL=ws://localhost:17880
LIVEKIT_API_KEY=devkey
# LiveKit requires ≥32 characters; must match docker-compose --keys value
LIVEKIT_API_SECRET=f6d5c4b3a2918e7d6c5b4a39281706f5

# IP clients use for WebRTC media (ICE). For phones/other PCs on your LAN, set your
# computer's LAN address (e.g. 192.168.1.10). Must match docker-compose advertise IP.
LIVEKIT_ADVERTISE_IP=127.0.0.1

# WebRTC UDP port range. Each concurrent WebRTC peer consumes ~1 port, so this range
# caps simultaneous participants per node. 50000-60000 gives ~10k peer slots.
LIVEKIT_UDP_START=50000
LIVEKIT_UDP_END=60000

# TURN relay for viewers behind symmetric NAT / corporate firewalls.
# Required in production — leave true. Set LIVEKIT_TURN_DOMAIN to a real domain
# with a TLS cert for TURN/TLS on 5349. For local-only dev, 'localhost' is fine.
LIVEKIT_TURN_ENABLED=true
LIVEKIT_TURN_DOMAIN=localhost
LIVEKIT_TURN_TLS_PORT=5349
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TURN_EXTERNAL_TLS=true

# Token Server Configuration
PORT=3004
