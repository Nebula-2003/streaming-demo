# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# LiveKit requires ≥32 characters; must match docker-compose --keys value
LIVEKIT_API_SECRET=f6d5c4b3a2918e7d6c5b4a39281706f5

# IP clients use for WebRTC media (ICE). For phones/other PCs on your LAN, set your
# computer's LAN address (e.g. 192.168.1.10). Must match docker-compose advertise IP.
LIVEKIT_ADVERTISE_IP=127.0.0.1

# Token Server Configuration
PORT=3004
