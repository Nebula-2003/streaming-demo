{
    "name": "livekit-streaming-app",
    "version": "1.0.0",
    "description": "Self-hosted LiveKit video streaming application with host and viewer clients",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "setup": "bash install-livekit.sh",
        "livekit:start": "docker compose up",
        "livekit:start:bg": "docker compose up -d",
        "livekit:stop": "docker compose down",
        "livekit:logs": "docker compose logs -f",
        "livekit:restart": "docker compose restart"
    },
    "keywords": [
        "livekit",
        "streaming",
        "video",
        "webrtc",
        "live-stream"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "livekit-server-sdk": "^2.0.0",
        "dotenv": "^16.3.1"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}